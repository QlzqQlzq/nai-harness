{
  "manifest_version": 2,
  "id": "local.nai-plugin",
  "version": "0.1.0",
  "name": "nai harness",
  "description": "NAI绘图、提示词解析、角色检索、引用反推与重画，支持多服务和密钥轮询。",
  "author": {"name": "QlzqQlzq", "url": "https://github.com/QlzqQlzq"},
  "license": "MIT",
  "plugin_type": "creative",
  "urls": {"repository": "https://github.com/QlzqQlzq/nai-harness"},
  "host_application": {"min_version": "1.0.12", "max_version": "1.3.10"},
  "sdk": {"min_version": "2.7.0", "max_version": "2.14.0"},
  "dependencies": [
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.28,<0.29"},
    {"type": "python_package", "name": "Pillow", "version_spec": ">=10,<14"},
    {"type": "python_package", "name": "pydantic", "version_spec": ">=2.10,<3"}
  ],
  "capabilities": ["send.hybrid", "message.get_by_id"],
  "i18n": {"default_locale": "zh-CN", "locales_path": "_locales", "supported_locales": ["zh-CN"]}
}
